# Mersennet Trade API server configuration

NETWORK=mersennet
# Mersennet L1 JSON-RPC + WebSocket (canonical endpoints)
RPC_URL=https://rpc.mersennet.com
WS_URL=wss://rpc.mersennet.com
PORT=4005

# Postgres (matches docker-compose.yml). For local dev against a host Postgres,
# point this at 127.0.0.1; in docker the host is `postgres`.
DATABASE_URL=postgresql://mersennet:CHANGE_ME@localhost:5432/mersennet_trade   # docker-compose derives this from POSTGRES_PASSWORD in .env

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_API_KEY=change-me

ALLOWED_ORIGINS=https://trade.mersennet.com,http://localhost:3000

# Optional: forward feedback submissions to a Telegram group (contact field withheld)
FEEDBACK_TELEGRAM_BOT_TOKEN=
FEEDBACK_TELEGRAM_CHAT_ID=
FEEDBACK_TELEGRAM_INCLUDE_CONTACT=0   # 1 only for a private group

# Hosts run by the team (public node, validators), comma-separated: excluded from
# community node discovery and always included in the build-parity poll.
FLEET_IPS=
